# =============================================================
# PartSphere (PartNexa) Backend — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================

# ----- Server -----
NODE_ENV=development
PORT=5000

# ----- Database (PostgreSQL / Supabase) -----
# Supabase Transaction Pooler (port 6543) or Direct Connection (port 5432)
# Example Supabase Transaction Pooler (Recommended for app queries):
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Example Supabase Direct Connection:
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Optional Supabase direct connection for Prisma migrations:
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Local PostgreSQL fallback:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/partsphere?schema=public"

# Database mode: set to true ONLY for offline unit/integration test suites (Default: false)
USE_IN_MEMORY_DB=false

# ----- Supabase Auth / Storage (Optional) -----
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_service_key

# ----- JWT Authentication -----
# Generate random 64-byte hex: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=partsphere_super_secret_jwt_access_token_key_2024
JWT_REFRESH_SECRET=partsphere_super_secret_jwt_refresh_token_key_2024
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ----- CORS -----
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# ----- Razorpay Sandbox -----
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_key_secret

# ----- Nodemailer / Email -----
MAIL_HOST=smtp.ethereal.email
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=ethereal_user_placeholder
MAIL_PASS=ethereal_pass_placeholder
MAIL_FROM="PartSphere <noreply@partsphere.in>"

# ----- File Uploads -----
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ----- Platform Commission & Logistics -----
PLATFORM_COMMISSION_PERCENT=15
DELIVERY_BASE_FEE=49
FREE_DELIVERY_THRESHOLD=999
DIFM_HOME_VISIT_SURCHARGE=199

# ----- Google Maps Platform -----
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
