{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/admin/(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/delivery/(.*)",
      "destination": "/delivery/index.html"
    },
    {
      "source": "/shop/(.*)",
      "destination": "/shop/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
